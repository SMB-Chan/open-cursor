#!/usr/bin/env node
"use strict";

const http = require("node:http");
const fs = require("node:fs");
const path = require("node:path");
const os = require("node:os");
const { execSync } = require("node:child_process");

const BRIDGE_URL = process.env.BRIDGE_URL || "http://127.0.0.1:9876";
const IS_PACKAGED = __dirname.startsWith("/opt/open-cursor/");
const STATE_FILE = process.env.OPEN_CURSOR_RUNTIME_DIR
  ? path.join(process.env.OPEN_CURSOR_RUNTIME_DIR, "run", "execution-state.json")
  : path.join(os.homedir(), ".cursor-codex-bridge", "run", "execution-state.json");
const REFRESH_INTERVAL_MS = 1000;

// ANSI Colors
const RESET = "\x1b[0m";
const BOLD = "\x1b[1m";
const DIM = "\x1b[2m";
const GREEN = "\x1b[32m";
const YELLOW = "\x1b[33m";
const BLUE = "\x1b[34m";
const CYAN = "\x1b[36m";
const MAGENTA = "\x1b[35m";
const RED = "\x1b[31m";
const BG_BLUE = "\x1b[44m";
const CLEAR_SCREEN = "\x1b[2J\x1b[H";

// Braille spinner frames for live terminal animation
const SPINNER_FRAMES = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"];

function renderLogo(termWidth) {
  const logo = [
    "   ___                   ___                            ",
    "  / _ \\ _ __  ___ _ _   / __|  _ _ _ ___ ___  _ _       ",
    " | (_) | '_ \\/ -_) ' \\ | (__  | '_| (_-</ _ \\/ '_|      ",
    "  \\___/| .__/\\___|_||_| \\___| |_| |_/__/\\___/|_|        ",
    "       |_| ⚡ Multi-Agent Coding Bridge · v2.9.2        "
  ];
  const colors = [CYAN, CYAN, BLUE, MAGENTA, MAGENTA];
  return logo.map((line, idx) => colors[idx] + BOLD + line + RESET).join("\n") + "\n";
}

function renderLogoHeader(termRows, termWidth) {
  if (termRows && termRows < 24) {
    return `${CYAN}${BOLD} ✦ OPEN-CURSOR${RESET} · ${MAGENTA}Multi-Agent Autonomous Coding Bridge v2.9.2${RESET} ${DIM}[Codex · Gemini · MiMo]${RESET}\n`;
  }
  return renderLogo(termWidth);
}

function fetchMonitorData(targetWorkspace) {
  return new Promise((resolvePromise) => {
    const wsParam = targetWorkspace ? `?workspace=${encodeURIComponent(targetWorkspace)}` : "";
    const req = http.get(`${BRIDGE_URL}/v1/monitor${wsParam}`, { timeout: 1200 }, (res) => {
      if (res.statusCode !== 200) {
        res.resume();
        return resolvePromise(null);
      }
      let body = "";
      res.setEncoding("utf8");
      res.on("data", (chunk) => (body += chunk));
      res.on("end", () => {
        try {
          const parsed = JSON.parse(body);
          if (parsed && parsed.llm && parsed.workspace) {
            return resolvePromise(parsed);
          }
          resolvePromise(null);
        } catch {
          resolvePromise(null);
        }
      });
    });
    req.on("error", () => resolvePromise(null));
    req.on("timeout", () => {
      req.destroy();
      resolvePromise(null);
    });
  });
}

function loadLocalFallback(targetWorkspace) {
  let execution = {
    active: false,
    mode: "idle",
    step: 0,
    currentAction: "待機中 (アイドル)",
    targetFile: null,
    recentSteps: [],
  };
  try {
    if (fs.existsSync(STATE_FILE)) {
      execution = JSON.parse(fs.readFileSync(STATE_FILE, "utf8"));
    }
  } catch {}

  const ws = targetWorkspace || process.env.OPEN_CURSOR_WORKSPACE || process.cwd();
  let modifiedFiles = [];
  let isGitRepo = false;
  let gitBranch = "";
  try {
    gitBranch = execSync("git rev-parse --abbrev-ref HEAD", { cwd: ws, stdio: ["pipe", "pipe", "ignore"] }).toString().trim();
    isGitRepo = true;
    const statusOut = execSync("git status --porcelain", { cwd: ws, stdio: ["pipe", "pipe", "ignore"] }).toString();
    if (statusOut.trim()) {
      modifiedFiles = statusOut.split("\n").filter(l => l.trim().length > 0).map(l => ({ status: l.slice(0, 2).trim(), file: l.slice(3).trim() }));
    }
  } catch {
    isGitRepo = false;
  }

  let recentFiles = [];
  try {
    const entries = fs.readdirSync(ws);
    for (const name of entries) {
      if (!name.startsWith(".")) {
        const full = path.join(ws, name);
        try {
          const s = fs.statSync(full);
          if (s.isFile()) {
            recentFiles.push({ name, sizeBytes: s.size, mtimeMs: s.mtimeMs });
          }
        } catch {}
      }
    }
    recentFiles.sort((a, b) => b.mtimeMs - a.mtimeMs);
  } catch {}

  let usageData = null;
  const now = Date.now();
  if (cachedFallbackUsage && now - lastFallbackUsageFetch < FALLBACK_CACHE_TTL_MS) {
    usageData = cachedFallbackUsage;
  } else {
    try {
      const usageOut = execSync("usage --json", { timeout: 2000, stdio: ["pipe", "pipe", "ignore"] }).toString();
      usageData = JSON.parse(usageOut);
      cachedFallbackUsage = usageData;
      lastFallbackUsageFetch = now;
    } catch {
      try {
        const usageBin = path.join(__dirname, "usage");
        const usageOut = execSync(`node "${usageBin}" --json`, { timeout: 2000, stdio: ["pipe", "pipe", "ignore"] }).toString();
        usageData = JSON.parse(usageOut);
        cachedFallbackUsage = usageData;
        lastFallbackUsageFetch = now;
      } catch {}
    }
  }

  const cUsage = usageData?.codex;
  const gUsage = usageData?.antigravity;
  const mUsage = usageData?.mimo;

  return {
    timestamp: new Date().toISOString(),
    llm: {
      codex: {
        name: "OpenAI Codex",
        modelId: cUsage?.modelId || "gpt-6-astra",
        displayName: cUsage?.displayName || "GPT-6-Astra",
        billing: cUsage?.billing || "定額サブスク（追加課金なし）",
        status: cUsage?.status || "READY",
        quota: {
          limit: cUsage?.quota?.summary || "50/50回 残り (100%)",
          resetInfo: cUsage?.quota?.resetTime || "3時間サイクル自動回復",
          percent: cUsage?.quota?.percent ?? 100,
        },
      },
      antigravity: {
        name: "Google Gemini",
        modelId: gUsage?.modelId || "gemini-3.1-pro-high",
        displayName: gUsage?.displayName || "Gemini 3.1 Pro (High)",
        billing: gUsage?.billing || "定額サブスク（追加課金なし）",
        status: gUsage?.status || "READY",
        quota: {
          limit: gUsage?.quota?.summary || "高速クォータ内 (正常稼働)",
          resetInfo: gUsage?.quota?.resetTime || "日次/時間枠自動リセット",
          percent: gUsage?.quota?.percent ?? 100,
        },
      },
      mimo: {
        name: "Xiaomi MiMo",
        modelId: mUsage?.modelId || "mimo-v2.5-pro",
        displayName: mUsage?.displayName || "Xiaomi MiMo v2.5 Pro",
        billing: mUsage?.billing || "トークンプラン (API Key)",
        status: mUsage?.status || "READY",
        quota: {
          limit: mUsage?.quota?.summary || "APIトークン残量準拠",
          resetInfo: "従量トークン",
        },
      },
    },
    workspace: {
      workspacePath: ws,
      workspaceName: path.basename(ws),
      isGitRepo,
      gitBranch,
      modifiedFiles,
      recentFiles: recentFiles.slice(0, 8),
    },
    execution,
  };
}

function renderBar(percent, width = 14) {
  const p = Math.max(0, Math.min(100, Number(percent) || 0));
  const filled = Math.round((p / 100) * width);
  const empty = width - filled;
  return `[${"▰".repeat(filled)}${"▱".repeat(empty)}] ${p}%`;
}

function formatBytes(bytes) {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function renderScreen(data, frame = 1, latencyMs = 0) {
  const termWidth = Math.max(70, Math.min(100, (process.stdout.columns || 80) - 2));
  const termRows = process.stdout.rows || 30;
  const boxTop = `╔${"═".repeat(termWidth)}╗`;
  const boxBottom = `╚${"═".repeat(termWidth)}╝`;
  const boxMid = `╠${"═".repeat(termWidth)}╣`;

  const ws = data.workspace || {};
  const exec = data.execution || {};
  const llm = data.llm || {};
  const nowStr = new Date().toLocaleTimeString("ja-JP");

  const spinner = SPINNER_FRAMES[frame % SPINNER_FRAMES.length];
  const pulseDot = frame % 2 === 0 ? `${GREEN}●${RESET}` : `${CYAN}◉${RESET}`;
  const latencyStr = latencyMs !== undefined ? `${latencyMs}ms` : "ok";

  let out = CLEAR_SCREEN;

  // 0. Original ASCII Logo Banner
  out += renderLogoHeader(termRows, termWidth);

  // Monitor Box Header
  out += `${CYAN}${BOLD}${boxTop}${RESET}\n`;
  const liveTag = `${pulseDot} ${BOLD}LIVE${RESET} ${DIM}[${spinner} 1.0s · #${frame} · ${latencyStr}]${RESET}`;
  const titlePlain = `  🚀 Open-Cursor Live Monitor  [LIVE] [1.0s · #${frame} · ${latencyStr}]`;
  const padLen = Math.max(2, termWidth - titlePlain.length - nowStr.length - 2);
  out += `${CYAN}${BOLD}║${RESET}  🚀 ${BOLD}Open-Cursor Live Monitor${RESET}  ${liveTag}${" ".repeat(padLen)}${DIM}${nowStr}${RESET}${CYAN}${BOLD}  ║${RESET}\n`;
  
  const gitPlain = ws.isGitRepo ? `[Git: ${ws.gitBranch || "main"}]` : "[Non-Git]";
  const maxPathLen = Math.max(10, termWidth - gitPlain.length - 28);
  const displayPath = ws.workspacePath ? (ws.workspacePath.length > maxPathLen ? "..." + ws.workspacePath.slice(-(maxPathLen - 3)) : ws.workspacePath) : "未指定";
  const pathPadLen = Math.max(2, termWidth - displayPath.length - gitPlain.length - 26);
  out += `${CYAN}${BOLD}║${RESET}  📁 作業ディレクトリ: ${YELLOW}${displayPath}${RESET}${" ".repeat(pathPadLen)}${CYAN}${BOLD}${gitPlain}${RESET}${CYAN}${BOLD}  ║${RESET}\n`;
  out += `${CYAN}${BOLD}${boxMid}${RESET}\n`;

  // 1. LLM Status Section
  out += `${BOLD}  🤖 LLM 利用残量・クォータ [usage コマンド連携]${RESET}\n`;
  const cModel = llm.codex?.modelId ? `[${llm.codex.modelId}]` : "";
  const gModel = llm.antigravity?.modelId ? `[${llm.antigravity.modelId}]` : "";
  const mModel = llm.mimo?.modelId ? `[${llm.mimo.modelId}]` : "";

  out += `  ${GREEN}●${RESET} ${BOLD}OpenAI Codex${RESET}  ${CYAN}${cModel.padEnd(23)}${RESET}: ${GREEN}${llm.codex?.status || "READY"}${RESET} · ${CYAN}${llm.codex?.billing || "定額サブスク"}${RESET}\n`;
  out += `    └─ 残量: ${BOLD}${llm.codex?.quota?.limit || llm.codex?.quota?.summary || "ChatGPT利用枠"}${RESET} ${DIM}(${llm.codex?.quota?.resetInfo || "自動回復"})${RESET}\n`;

  out += `  ${GREEN}●${RESET} ${BOLD}Google Gemini${RESET} ${CYAN}${gModel.padEnd(23)}${RESET}: ${GREEN}${llm.antigravity?.status || "READY"}${RESET} · ${CYAN}${llm.antigravity?.billing || "定額サブスク"}${RESET}\n`;
  out += `    └─ 残量: ${BOLD}${llm.antigravity?.quota?.limit || llm.antigravity?.quota?.summary || "Google One AI Pro"}${RESET} ${DIM}(${llm.antigravity?.quota?.resetInfo || "自動リセット"})${RESET}\n`;

  out += `  ${YELLOW}●${RESET} ${BOLD}Xiaomi MiMo${RESET}   ${CYAN}${mModel.padEnd(23)}${RESET}: ${GREEN}${llm.mimo?.status || "READY"}${RESET} · ${YELLOW}${llm.mimo?.billing || "トークンプラン"}${RESET}\n`;
  out += `    └─ 残量: ${BOLD}${llm.mimo?.quota?.limit || llm.mimo?.quota?.summary || "APIトークン"}${RESET}\n`;

  out += `${CYAN}${BOLD}${boxMid}${RESET}\n`;

  // 2. Active Execution & Steps Section
  out += `${BOLD}  ⚡ 自律エージェントの現在のアクティビティ${RESET}\n`;
  if (exec.active) {
    const bar = renderBar(exec.progress || (10 + (exec.step || 1) * 6));
    const modeName = exec.autoMode ? `自動判別 (Auto) ➔ ${exec.selectedMode || exec.mode}` : (exec.mode || "自律");
    out += `  ${MAGENTA}${BOLD}${spinner} 実行中 [${modeName}]${RESET}  進捗: ${CYAN}${BOLD}${bar}${RESET}\n`;
    if (exec.modelId) {
      out += `  稼働モデルID  : ${CYAN}${BOLD}🎯 ${exec.modelId}${RESET} ${DIM}(${exec.modelDisplayName || exec.agent || ""})${RESET}\n`;
    }
    if (Array.isArray(exec.activeModels) && exec.activeModels.length > 1) {
      out += `  協調モデル構成: ${DIM}${exec.activeModels.join(" ➔ ")}${RESET}\n`;
    }
    out += `  現在アクション: ${BOLD}${exec.currentAction || "処理中..."}${RESET} ${DIM}(ステップ ${exec.step || 1})${RESET}\n`;
    if (exec.targetFile) {
      out += `  操作ファイル  : ${YELLOW}${BOLD}📄 ${exec.targetFile}${RESET}\n`;
    }
  } else {
    out += `  ${GREEN}${spinner}${RESET} ${DIM}アイドル待機中 (常時ヘルスチェック稼働・リクエスト待機中)${RESET}\n`;
    if (exec.modelId) {
      out += `  最終稼働モデル: ${DIM}🎯 ${exec.modelId} (${exec.modelDisplayName || exec.agent || ""})${RESET}\n`;
    }
    if (exec.targetFile) {
      out += `  最終更新ファイル: ${YELLOW}${BOLD}📄 ${exec.targetFile}${RESET}\n`;
    }
  }

  // Recent steps list
  if (Array.isArray(exec.recentSteps) && exec.recentSteps.length > 0) {
    out += `  ${DIM}直近の実行ステップ履歴:${RESET}\n`;
    for (const s of exec.recentSteps.slice(0, 4)) {
      const dur = s.duration ? `(${s.duration.toFixed(1)}s)` : "";
      out += `   └─ ${CYAN}Step ${s.step}${RESET}: ${s.action || s.file || "処理"} ${DIM}${dur}${RESET}\n`;
    }
  }

  // Lifetime bridge stats
  const stats = data.stats;
  if (stats && stats.requests) {
    const req = stats.requests;
    const uptime = stats.uptime_seconds || 0;
    const uptimeStr = uptime >= 3600
      ? `${Math.floor(uptime / 3600)}h${String(Math.floor((uptime % 3600) / 60)).padStart(2, "0")}m`
      : uptime >= 60
        ? `${Math.floor(uptime / 60)}m${String(uptime % 60).padStart(2, "0")}s`
        : `${uptime}s`;
    const agentCounts = Object.entries(stats.agents || {});
    out += `  ${DIM}📊 累計リクエスト:${RESET} ${BOLD}${req.total || 0}${RESET} ${DIM}(完了 ${req.completed || 0} / 失敗 ${req.failed || 0} / 中止 ${req.cancelled || 0}) · 稼働 ${uptimeStr}${RESET}\n`;
    if (agentCounts.length > 0) {
      out += `     └─ ${DIM}エージェント別: ${agentCounts.map(([a, n]) => `${a}:${n}`).join(" · ")}${RESET}\n`;
    }
  }

  out += `${CYAN}${BOLD}${boxMid}${RESET}\n`;

  // 3. Workspace Edited Files Section
  out += `${BOLD}  📝 編集中のファイル・ワークスペース変更状況${RESET}\n`;
  const modFiles = ws.modifiedFiles || [];
  if (modFiles.length > 0) {
    for (const f of modFiles.slice(0, 5)) {
      out += `  ${YELLOW}${BOLD}[${f.status || "M"}]${RESET} ${f.file}\n`;
    }
    if (modFiles.length > 5) {
      out += `  ${DIM}... 他 ${modFiles.length - 5} 件の変更${RESET}\n`;
    }
  } else if (Array.isArray(ws.recentFiles) && ws.recentFiles.length > 0) {
    for (const f of ws.recentFiles.slice(0, 4)) {
      const size = formatBytes(f.sizeBytes || 0);
      out += `  ${GREEN}📄${RESET} ${BOLD}${f.name}${RESET} ${DIM}(${size})${RESET}\n`;
    }
  } else {
    out += `  ${DIM}(変更されたファイルはありません)${RESET}\n`;
  }

  out += `${CYAN}${BOLD}${boxBottom}${RESET}\n`;
  out += ` ${CYAN}${spinner}${RESET} ${DIM}[r] 手動更新  [b] モバイル画面 (9880)  [q] 終了  |  更新回数: #${frame}${RESET}\n`;

  process.stdout.write(out);
}

const nonFlagArgs = process.argv.slice(2).filter((a) => !a.startsWith("-"));
let activeWorkspace = nonFlagArgs[0] ? path.resolve(nonFlagArgs[0]) : (process.env.OPEN_CURSOR_WORKSPACE || process.cwd());

let frameIndex = 0;
let isTicking = false;
let timer = null;

async function loop() {
  if (isTicking) return;
  isTicking = true;
  frameIndex++;
  const start = Date.now();
  try {
    let data = await fetchMonitorData(activeWorkspace);
    if (!data) {
      data = loadLocalFallback(activeWorkspace);
    }
    const latencyMs = Date.now() - start;
    renderScreen(data, frameIndex, latencyMs);
  } catch {
  } finally {
    isTicking = false;
    if (process.argv.includes("--once")) {
      process.exit(0);
    } else {
      timer = setTimeout(loop, REFRESH_INTERVAL_MS);
    }
  }
}

// Setup keyboard handlers
if (process.stdin.isTTY) {
  process.stdin.setRawMode(true);
  process.stdin.resume();
  process.stdin.setEncoding("utf8");
  process.stdin.on("data", (key) => {
    if (key === "q" || key === "\u0003") { // q or Ctrl+C
      if (timer) clearTimeout(timer);
      process.stdout.write("\n" + RESET);
      process.exit(0);
    } else if (key === "r") {
      if (timer) clearTimeout(timer);
      loop();
    } else if (key === "b") {
      try {
        const cmd = process.platform === "darwin" ? "open" : "xdg-open";
        execSync(`${cmd} http://127.0.0.1:9880 2>/dev/null || true`);
      } catch {}
    }
  });
}

// Initial draw and timer
loop();

process.on("SIGINT", () => {
  if (timer) clearTimeout(timer);
  process.stdout.write("\n" + RESET);
  process.exit(0);
});
process.on("SIGTERM", () => {
  if (timer) clearTimeout(timer);
  process.stdout.write("\n" + RESET);
  process.exit(0);
});
