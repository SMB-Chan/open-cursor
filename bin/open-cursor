#!/bin/bash
# Open-Cursor Terminal Launcher
# 課金なしのマルチエージェントコーディングIDE

BRIDGE_DIR="$HOME/.cursor-codex-bridge"
BRIDGE_PORT="${BRIDGE_PORT:-9876}"
BRIDGE_URL="http://127.0.0.1:$BRIDGE_PORT"
LOG_FILE="$BRIDGE_DIR/bridge.log"
PID_FILE="$BRIDGE_DIR/bridge.pid"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${CYAN}${BOLD}"
echo "╔══════════════════════════════════════════════════╗"
echo "║         Open-Cursor Multi-Agent Launcher         ║"
echo "║       課金なし · サブスクリプションのみ            ║"
echo "╚══════════════════════════════════════════════════╝"
echo -e "${NC}"

is_bridge_running() {
  curl -sf --connect-timeout 1 "$BRIDGE_URL/health" >/dev/null 2>&1
}

# Start bridge if not running
if ! is_bridge_running; then
  echo -e "${YELLOW}Starting bridge server...${NC}"
  cd "$BRIDGE_DIR/server"
  setsid node index.js > "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"

  for i in $(seq 1 20); do
    if is_bridge_running; then break; fi
    sleep 0.5
  done

  if is_bridge_running; then
    echo -e "${GREEN}Bridge started.${NC}"
  else
    echo -e "${RED}Bridge failed. Check: $LOG_FILE${NC}"
    exit 1
  fi
else
  echo -e "${GREEN}Bridge already running.${NC}"
fi

# Show status
HEALTH=$(curl -sf "$BRIDGE_URL/health" 2>/dev/null)
echo -e "${CYAN}$HEALTH${NC}" | python3 -m json.tool 2>/dev/null || echo "$HEALTH"

echo ""
echo -e "  ${CYAN}API:${NC} $BRIDGE_URL/v1"
echo -e "  ${CYAN}Logs:${NC} tail -f $LOG_FILE"
echo -e "  ${CYAN}Stop:${NC} $BRIDGE_DIR/bin/stop-bridge"
