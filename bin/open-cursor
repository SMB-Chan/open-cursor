#!/bin/bash
# Open-Cursor Terminal Launcher & Mobile Dashboard
# 課金なしのマルチエージェントコーディングIDE

BRIDGE_DIR="$HOME/.cursor-codex-bridge"
BRIDGE_PORT="${BRIDGE_PORT:-9876}"
BRIDGE_URL="http://127.0.0.1:$BRIDGE_PORT"
LOG_FILE="$BRIDGE_DIR/bridge.log"
PID_FILE="$BRIDGE_DIR/bridge.pid"

MOBILE_PORT="${MOBILE_PORT:-9880}"
MOBILE_URL="http://127.0.0.1:$MOBILE_PORT"
MOBILE_LOG="$BRIDGE_DIR/mobile.log"
MOBILE_PID_FILE="$BRIDGE_DIR/mobile.pid"
MOBILE_TOKEN_FILE="$BRIDGE_DIR/mobile.token"
MOBILE_ALLOW_REMOTE="${MOBILE_ALLOW_REMOTE:-0}"
MOBILE_ALLOW_EXEC="${MOBILE_ALLOW_EXEC:-0}"
MOBILE_HOST="${MOBILE_HOST:-}"
MOBILE_TOKEN="${MOBILE_TOKEN:-}"
MOBILE_REMOTE_TRANSPORT="${MOBILE_REMOTE_TRANSPORT:-}"
MOBILE_TLS_CERT_FILE="${MOBILE_TLS_CERT_FILE:-}"
MOBILE_TLS_KEY_FILE="${MOBILE_TLS_KEY_FILE:-}"
MOBILE_PUBLIC_URL="${MOBILE_PUBLIC_URL:-}"
LAUNCH_WORKSPACE="${OPEN_CURSOR_WORKSPACE:-$PWD}"
export OPEN_CURSOR_WORKSPACE="$LAUNCH_WORKSPACE"
export WORKSPACE_DIR="${WORKSPACE_DIR:-$LAUNCH_WORKSPACE}"

# ── Ensure PATH includes ~/.local/bin and Node.js ──

export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

if ! command -v node &>/dev/null; then
  for n in "$HOME"/.nvm/versions/node/*/bin/node; do
    if [ -x "$n" ]; then
      export PATH="$(dirname "$n"):$PATH"
    fi
  done
fi

if ! command -v node &>/dev/null && [ -s "$HOME/.nvm/nvm.sh" ]; then
  export NVM_DIR="$HOME/.nvm"
  # shellcheck source=/dev/null
  . "$HOME/.nvm/nvm.sh" --no-use 2>/dev/null || true
  nvm use default &>/dev/null || nvm use stable &>/dev/null || true
fi

NODE_BIN="$(command -v node 2>/dev/null || true)"

is_true() {
  case "${1,,}" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

if is_true "$MOBILE_ALLOW_REMOTE"; then
  case "${MOBILE_REMOTE_TRANSPORT,,}" in
    tls|https)
      MOBILE_REMOTE_TRANSPORT="tls"
      MOBILE_HOST="${MOBILE_HOST:-0.0.0.0}"
      if [ -z "$MOBILE_TLS_CERT_FILE" ] || [ -z "$MOBILE_TLS_KEY_FILE" ]; then
        echo "Error: TLS remote mode requires MOBILE_TLS_CERT_FILE and MOBILE_TLS_KEY_FILE." >&2
        exit 1
      fi
      if [ ! -r "$MOBILE_TLS_CERT_FILE" ] || [ ! -r "$MOBILE_TLS_KEY_FILE" ]; then
        echo "Error: Mobile TLS certificate/key is not readable." >&2
        exit 1
      fi
      if [ -n "$MOBILE_PUBLIC_URL" ] && [[ "$MOBILE_PUBLIC_URL" != https://* ]]; then
        echo "Error: MOBILE_PUBLIC_URL must use https:// when MOBILE_REMOTE_TRANSPORT=tls." >&2
        exit 1
      fi
      MOBILE_SCHEME="https"
      ;;
    tunnel|trusted-tunnel|vpn)
      MOBILE_REMOTE_TRANSPORT="tunnel"
      if [ -z "$MOBILE_HOST" ]; then
        echo "Error: Tunnel remote mode requires an explicit MOBILE_HOST (VPN/overlay IP or loopback)." >&2
        exit 1
      fi
      case "$MOBILE_HOST" in
        0.0.0.0|::|"[::]")
          echo "Error: Tunnel mode refuses wildcard MOBILE_HOST because it would expose plaintext HTTP outside the tunnel." >&2
          exit 1
          ;;
        127.0.0.1|localhost|::1)
          if [ -z "$MOBILE_PUBLIC_URL" ]; then
            echo "Error: Loopback tunnel mode requires MOBILE_PUBLIC_URL for the externally reachable tunnel/proxy URL." >&2
            exit 1
          fi
          ;;
      esac
      MOBILE_SCHEME="http"
      ;;
    *)
      echo "Error: Remote mobile access requires MOBILE_REMOTE_TRANSPORT=tls or tunnel." >&2
      exit 1
      ;;
  esac
  if [ -z "$MOBILE_TOKEN" ] && [ -r "$MOBILE_TOKEN_FILE" ]; then
    MOBILE_TOKEN="$(cat "$MOBILE_TOKEN_FILE")"
  fi
  if [ -z "$MOBILE_TOKEN" ]; then
    if [ -z "$NODE_BIN" ]; then
      echo "Error: Node.js is required to generate the mobile pairing token." >&2
      exit 1
    fi
    MOBILE_TOKEN="$($NODE_BIN -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("hex"))')"
    umask 077
    printf '%s\n' "$MOBILE_TOKEN" > "$MOBILE_TOKEN_FILE"
    chmod 600 "$MOBILE_TOKEN_FILE"
  fi
else
  MOBILE_HOST="${MOBILE_HOST:-127.0.0.1}"
  MOBILE_REMOTE_TRANSPORT=""
  MOBILE_SCHEME="http"
fi

export MOBILE_ALLOW_REMOTE MOBILE_ALLOW_EXEC MOBILE_HOST MOBILE_TOKEN MOBILE_REMOTE_TRANSPORT
export MOBILE_TLS_CERT_FILE MOBILE_TLS_KEY_FILE

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

echo -e "${CYAN}${BOLD}"
echo "   ___                   ___                            "
echo "  / _ \ _ __  ___ _ _   / __|  _ _ _ ___ ___  _ _       "
echo " | (_) | '_ \/ -_) ' \ | (__  | '_| (_-</ _ \/ '_|      "
echo "  \___/| .__/\___|_||_| \___| |_| |_/__/\___/|_|        "
echo "       |_| ⚡ Multi-Agent Coding Bridge · v2.6.0        "
echo -e "${NC}"

is_bridge_running() {
  curl -sf --connect-timeout 1 "$BRIDGE_URL/health" >/dev/null 2>&1
}

is_mobile_running() {
  local health_host="${MOBILE_HOST:-127.0.0.1}"
  case "$health_host" in
    0.0.0.0) health_host="127.0.0.1" ;;
    ::|"[::]") health_host="[::1]" ;;
    ::1) health_host="[::1]" ;;
  esac
  if [ "${MOBILE_SCHEME:-http}" = "https" ]; then
    curl -ksf --connect-timeout 1 "https://$health_host:$MOBILE_PORT/healthz" >/dev/null 2>&1
  else
    curl -sf --connect-timeout 1 "http://$health_host:$MOBILE_PORT/healthz" >/dev/null 2>&1
  fi
}

# Start bridge if not running
if ! is_bridge_running; then
  if [ -z "$NODE_BIN" ]; then
    echo -e "${RED}Error: Node.js is not found in PATH or NVM.${NC}"
    exit 1
  fi
  echo -e "${YELLOW}Starting bridge server...${NC}"
  cd "$BRIDGE_DIR/server"
  setsid "$NODE_BIN" index.js > "$LOG_FILE" 2>&1 &
  echo $! > "$PID_FILE"

  for i in $(seq 1 20); do
    if is_bridge_running; then break; fi
    sleep 0.5
  done

  if is_bridge_running; then
    echo -e "${GREEN}Bridge started.${NC}"
  else
    echo -e "${RED}Bridge failed. Check: $LOG_FILE${NC}"
    exit 1
  fi
else
  echo -e "${GREEN}Bridge already running.${NC}"
fi

# Start mobile dashboard if not running
if ! is_mobile_running && [ -d "$BRIDGE_DIR/mobile" ]; then
  echo -e "${YELLOW}Starting Mobile Web Dashboard...${NC}"
  cd "$BRIDGE_DIR/mobile"
  setsid "$NODE_BIN" server.js > "$MOBILE_LOG" 2>&1 &
  echo $! > "$MOBILE_PID_FILE"

  for i in $(seq 1 10); do
    if is_mobile_running; then break; fi
    sleep 0.5
  done

  if is_mobile_running; then
    echo -e "${GREEN}Mobile Web Dashboard started.${NC}"
  fi
fi

# Show status
HEALTH=$(curl -sf "$BRIDGE_URL/health" 2>/dev/null)
echo -e "${CYAN}$HEALTH${NC}" | python3 -m json.tool 2>/dev/null || echo "$HEALTH"

LOCAL_IP=$(ip route get 1 2>/dev/null | awk '{print $7;exit}' || echo "127.0.0.1")

echo ""
echo -e "  ${CYAN}API:${NC} $BRIDGE_URL/v1"
if is_true "$MOBILE_ALLOW_REMOTE"; then
  if [ -n "$MOBILE_PUBLIC_URL" ]; then
    MOBILE_PAIRING_BASE="${MOBILE_PUBLIC_URL%/}"
  else
    MOBILE_PAIRING_BASE="${MOBILE_SCHEME}://${LOCAL_IP}:${MOBILE_PORT}"
  fi
  echo -e "  ${GREEN}${BOLD}📱 Mobile Web:${NC} ${MOBILE_PAIRING_BASE}/#token=${MOBILE_TOKEN}"
  echo -e "  ${CYAN}Transport:${NC} ${MOBILE_REMOTE_TRANSPORT}"
  echo -e "  ${YELLOW}Pairing token is a secret; remote mode requires TLS or an encrypted trusted tunnel.${NC}"
else
  echo -e "  ${GREEN}${BOLD}📱 Mobile Web:${NC} http://127.0.0.1:${MOBILE_PORT} (localhost only)"
  echo -e "  ${CYAN}Remote opt-in:${NC} MOBILE_ALLOW_REMOTE=1 MOBILE_REMOTE_TRANSPORT=tls|tunnel $BRIDGE_DIR/bin/open-cursor"
fi
if is_true "$MOBILE_ALLOW_EXEC"; then
  echo -e "  ${RED}Remote shell execution: ENABLED${NC}"
else
  echo -e "  ${CYAN}Remote shell execution:${NC} disabled (MOBILE_ALLOW_EXEC=1 to opt in)"
fi
echo -e "  ${CYAN}Workspace:${NC} $WORKSPACE_DIR"
echo -e "  ${CYAN}Logs:${NC} tail -f $LOG_FILE"
echo -e "  ${CYAN}Stop:${NC} $BRIDGE_DIR/bin/stop-bridge"
echo ""
if is_true "$MOBILE_ALLOW_REMOTE"; then
  echo -e "  ${MAGENTA}💡 Pairing URLをスマホで開くと、認証済みのチャット・Git確認が可能です。${NC}"
fi
