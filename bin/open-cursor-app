#!/bin/bash
# GUI entry point: share the CLI's runtime, ports and startup validation.
set -euo pipefail
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/runtime-env.sh"
if [ -z "${OPEN_CURSOR_WORKSPACE:-}" ]; then
  for argument in "$@"; do
    if [ -d "$argument" ]; then
      export OPEN_CURSOR_WORKSPACE="$(readlink -f -- "$argument")"
      break
    elif [ -f "$argument" ]; then
      export OPEN_CURSOR_WORKSPACE="$(dirname -- "$(readlink -f -- "$argument")")"
      break
    fi
  done
fi
export OPEN_CURSOR_WORKSPACE="${OPEN_CURSOR_WORKSPACE:-$BRIDGE_DIR}"
if ! "$BRIDGE_DIR/bin/open-cursor"; then
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -i "$BRIDGE_DIR/share/open-cursor.svg" "Open-Cursor" "起動に失敗しました。$RUNTIME_DIR/bridge.log を確認してください。" || true
  fi
  exit 1
fi
if [ -n "${OPEN_CURSOR_EDITOR_BIN:-}" ]; then
  exec "$OPEN_CURSOR_EDITOR_BIN" "$@"
fi

CURSOR_BIN=""
if command -v cursor >/dev/null 2>&1; then
  CURSOR_BIN="cursor"
else
  for candidate in /usr/bin/cursor /usr/share/cursor/bin/cursor /opt/Cursor/AppRun; do
    if [ -x "$candidate" ]; then
      CURSOR_BIN="$candidate"
      break
    fi
  done
fi

if [ -z "$CURSOR_BIN" ]; then
  echo "Cursor が見つかりません。Cursor をインストールして再起動してください。" >&2
  exit 1
fi

HAS_MODE_FLAG=0
for arg in "$@"; do
  case "$arg" in
    --classic|--glass) HAS_MODE_FLAG=1; break ;;
  esac
done

if [ $HAS_MODE_FLAG -eq 0 ]; then
  if [ $# -eq 0 ]; then
    exec "$CURSOR_BIN" --classic "$OPEN_CURSOR_WORKSPACE"
  else
    exec "$CURSOR_BIN" --classic "$@"
  fi
else
  exec "$CURSOR_BIN" "$@"
fi
