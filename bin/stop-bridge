#!/bin/bash
# Only stop services whose process identity matches this installation.
set -euo pipefail
source "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/runtime-env.sh"
if [ -z "$NODE_BIN" ]; then
  echo "Node.js is required to verify service ownership before stopping." >&2
  exit 1
fi
"$NODE_BIN" "$BRIDGE_DIR/scripts/service-control.mjs" stop "$RUNTIME_DIR/bridge.pid" "$BRIDGE_DIR/server/index.js"
"$NODE_BIN" "$BRIDGE_DIR/scripts/service-control.mjs" stop "$RUNTIME_DIR/mobile.pid" "$BRIDGE_DIR/mobile/server.js"
