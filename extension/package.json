{
  "name": "open-cursor-bridge",
  "displayName": "Open-Cursor Multi-Agent Bridge",
  "description": "Codex + Antigravity + optional MiMo multi-agent coding bridge with execution receipts",
  "version": "2.8.0",
  "publisher": "open-cursor",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:openCursor.chat",
    "onCommand:openCursor.startBridge",
    "onCommand:openCursor.stopBridge",
    "onCommand:openCursor.showStatus",
    "onCommand:openCursor.selectAgent"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "openCursor.startBridge",
        "title": "Open-Cursor: Start Bridge Server"
      },
      {
        "command": "openCursor.stopBridge",
        "title": "Open-Cursor: Stop Managed Bridge Server"
      },
      {
        "command": "openCursor.showStatus",
        "title": "Open-Cursor: Show Agent Status"
      },
      {
        "command": "openCursor.selectAgent",
        "title": "Open-Cursor: Select Agent Routing Mode"
      },
      {
        "command": "openCursor.chat",
        "title": "Open-Cursor: Chat with Agents"
      }
    ],
    "keybindings": [
      {
        "command": "openCursor.chat",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      }
    ],
    "configuration": {
      "title": "Open-Cursor Bridge",
      "properties": {
        "openCursor.bridgePort": {
          "type": "number",
          "default": 9876,
          "minimum": 1,
          "maximum": 65535,
          "description": "Local bridge server port"
        },
        "openCursor.autoStartBridge": {
          "type": "boolean",
          "default": true,
          "description": "Start the local bridge automatically when Cursor finishes starting"
        },
        "openCursor.nodePath": {
          "type": "string",
          "default": "node",
          "description": "Node.js executable used to start the managed bridge"
        },
        "openCursor.defaultAgent": {
          "type": "string",
          "enum": [
            "auto",
            "autonomous",
            "collaborative",
            "pipeline",
            "mimo-gemini",
            "mimo",
            "codex",
            "antigravity"
          ],
          "default": "collaborative",
          "description": "Default agent routing mode. Auto is side-effect-aware; Autonomous explicitly enables auto-approved Gemini edits/commands."
        },
        "openCursor.workspacePath": {
          "type": "string",
          "default": "",
          "description": "Workspace path for agent context; defaults to the first open workspace folder"
        }
      }
    }
  },
  "scripts": {
    "check": "node --check src/extension.js && node --check src/sse.js && node --check src/receipt.js && node --check src/markdown.js && node --check src/sse.test.js && node --check src/receipt.test.js && node --check src/markdown.test.js",
    "test": "node --test src/sse.test.js src/receipt.test.js src/markdown.test.js"
  }
}
