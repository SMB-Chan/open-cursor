{
  "$schema": "./config.schema.json",
  "bridge": {
    "port": 9876,
    "host": "127.0.0.1"
  },
  "agents": {
    "codex": {
      "enabled": true,
      "binary": "codex",
      "authMode": "chatgpt",
      "billing": "NONE",
      "strengths": ["code-generation", "refactoring", "debugging", "git-operations"]
    },
    "antigravity": {
      "enabled": true,
      "binary": "~/.local/bin/agy",
      "authMode": "google-oauth",
      "billing": "NONE",
      "useG1Credits": false,
      "strengths": ["analysis", "architecture", "research", "multimodal"]
    }
  },
  "routing": {
    "default": "collaborative",
    "rules": {
      "analyze|research|explain|review|audit": "antigravity",
      "implement|create|build|write|fix|debug|refactor": "codex",
      "complex|multi-step": "collaborative",
      "default": "collaborative"
    }
  },
  "protection": {
    "note": "All paths are OUTSIDE Cursor's directories to survive updates",
    "bridgeDir": "~/.cursor-codex-bridge/",
    "codexDir": "~/.codex/",
    "geminiDir": "~/.gemini/antigravity-cli/",
    "cursorCanTouch": false
  }
}
