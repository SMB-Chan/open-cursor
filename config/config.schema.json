{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SMB-Chan/open-cursor/blob/main/config/config.schema.json",
  "title": "Open-Cursor reference configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["bridge", "execution", "agents", "routing", "protection"],
  "properties": {
    "$schema": { "type": "string" },
    "bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "host"],
      "properties": {
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "host": { "type": "string", "minLength": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agentTimeoutMs", "killGraceMs", "maxBodyBytes", "maxOutputBytes"],
      "properties": {
        "agentTimeoutMs": { "type": "integer", "minimum": 1000 },
        "killGraceMs": { "type": "integer", "minimum": 100 },
        "maxBodyBytes": { "type": "integer", "minimum": 1024 },
        "maxOutputBytes": { "type": "integer", "minimum": 1024 }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["codex", "antigravity"],
      "properties": {
        "codex": { "$ref": "#/$defs/agent" },
        "antigravity": {
          "allOf": [
            { "$ref": "#/$defs/agent" },
            {
              "type": "object",
              "properties": {
                "useG1Credits": { "type": "boolean" }
              }
            }
          ]
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "rules", "languages"],
      "properties": {
        "default": {
          "enum": ["collaborative", "pipeline", "codex", "antigravity"]
        },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "enum": ["collaborative", "pipeline", "codex", "antigravity"]
          }
        },
        "languages": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "uniqueItems": true
        }
      }
    },
    "protection": {
      "type": "object",
      "additionalProperties": true,
      "required": ["bridgeDir", "codexDir", "geminiDir"],
      "properties": {
        "note": { "type": "string" },
        "bridgeDir": { "type": "string" },
        "codexDir": { "type": "string" },
        "geminiDir": { "type": "string" },
        "loopbackOnlyByDefault": { "type": "boolean" },
        "browserOriginExecutionDenied": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "agent": {
      "type": "object",
      "required": ["enabled", "binary", "authMode", "billing", "strengths"],
      "properties": {
        "enabled": { "type": "boolean" },
        "binary": { "type": "string", "minLength": 1 },
        "authMode": { "type": "string", "minLength": 1 },
        "billing": { "type": "string", "minLength": 1 },
        "strengths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
